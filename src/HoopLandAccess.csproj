<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hoop Land Access: MelonLoader mod for blind players.
       Builds against the game's CURRENT generated assemblies, so a game update
       shows up here as a build error instead of a silent break. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>HoopLandAccess</AssemblyName>
    <RootNamespace>HoopLandAccess</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameDir>C:\Program Files (x86)\steam\steamapps\common\Hoop Land</GameDir>
    <ML>$(GameDir)\MelonLoader</ML>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(ML)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(ML)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(ML)\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(ML)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppAssemblies\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppAssemblies\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>
</Project>

